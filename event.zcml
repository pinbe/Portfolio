<configure
    xmlns="http://namespaces.zope.org/zope">
  <subscriber
    for=".interfaces.IPhoto
          zope.container.interfaces.IObjectAddedEvent"
    handler=".event_handlers.processQueueAdd"
      />
  <subscriber
    for=".interfaces.IPhoto
          zope.lifecycleevent.interfaces.IObjectModifiedEvent"
    handler=".event_handlers.processQueueAdd"
      />
</configure>