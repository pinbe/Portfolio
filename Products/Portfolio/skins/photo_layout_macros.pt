<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n">
  <head>
    <title>Display macros for arbitrary set of photos</title>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8"/>
  </head>
  <body>
    <!-- grid -->
    <div metal:define-macro="grid"
         tal:define="slide_size portal_object/slide_size;
                     mayBeDropable exists:dropable;
                     dropable python:True if mayBeDropable and dropable else False;
                     mayBeOrderable exists:orderable;
                     orderable python:True if mayBeOrderable and orderable else False"
         i18n:domain="portfolio">
      <div class="lightbox"
           tal:define="classes python:{'lightbox':True,
                                       'photo-drop-target': dropable,
                                       'empty': not len(infos)};
                       json_dumps python: modules['Products.Plinn.utils'].json_dumps"
           tal:attributes="class python:' '.join([k for (k, v) in classes.items() if v]);
                           data-lightbox_init_args python:json_dumps(
              {'complete': not batch.next,
              'container_type': options.get('container_type', 'portfolio'),
              'dropable': dropable,
              'orderable': orderable,
              'options': {
                'slideSize': portal_object.slide_size,
                'thumbnailSize': portal_object.thumb_size
                },
              }
              )">
        <div metal:define-macro="thumbnails"
             tal:omit-tag="">
          <tal:block tal:repeat="info infos">
            <div metal:define-macro="thumbnail"
                 tal:attributes="class python:'selected' if info.get('selected') else None"
                 draggable="true">
              <span tal:attributes="class python:'landscape' if info['thumbSize']['width'] > info['thumbSize']['height'] else 'portrait'">
                <a tal:attributes="href info/href; title info/title">
                  <img tal:attributes="src info/thumbUrl;
                                       alt info/title;
                                       height info/thumbSize/height;
                                       width info/thumbSize/width;"/>
                </a>
                <span>
                  <span tal:condition="features/checkbox|nothing"
                        tal:omit-tag="">
                    <input class="button cb"
                           type="checkbox" name="uids:list"
                           tal:attributes="value info/cmf_uid;
                                           id string:cb_${info/cmf_uid}"/>
                    <label class="button fa"
                           tal:attributes="for string:cb_${info/cmf_uid}"></label>
                  </span>
                  <a class="button selection"
                     tal:define="selected info/selected|nothing"
                     tal:condition="python:features.has_key('select')"
                     tal:attributes="href python:features['select'](info['o'], selected);
                                     name python:'remove_to_selection' if selected else 'add_to_selection';
                                     title python:'Remove from selection' if selected else 'Add to selection'"
                     i18n:attributes="title">
                    <i class="fa"></i>
                  </a>
                  <a class="button slide-del"
                     title="Delete"
                     tal:condition="python:features.has_key('del')"
                     tal:attributes="href python:features['del'](info['o'])"
                     i18n:attributes="title">
                    <i class="fas fa-times"></i>
                  </a>
                </span>
              </span>
            </div>
          </tal:block>
        </div>

      </div>

      <noscript>
        <div metal:use-macro="here/batch_macros/macros/navigation">batch navigation</div>
      </noscript>
      <script type="text/javascript"
              tal:attributes="src here/portfolio/jsbuild/photogrid_view.js/absolute_url"></script>
    </div>
    <!-- /grid -->

    <!-- film_bar -->
    <div metal:define-macro="film_bar" tal:omit-tag="">
      <nav class="film_bar"
           tal:define="blank_img string:$portal_url/transparent.gif;
                       json_dumps python: modules['Products.Plinn.utils'].json_dumps"
           tal:attributes="data-filmSliderContext python:json_dumps(
                  {'center': contextInfos['index'],
                   'reBaseCtxUrl' : contextInfos['reBaseCtxUrl'],
                   'canonicalUrl' : contextInfos['canonicalUrl']})">
        <div>
          <span tal:repeat="info contextInfos/infos">
            <a tal:attributes="href info/href;
                               title info/title;
                               class info/className;">
              <img tal:define="size info/thumbSize"
                   tal:attributes="src python:info['src'] if info['displayed'] else blank_img;
                                   alt info/title;
                                   height size/height;
                                   width size/width;"/>
            </a>
          </span>
        </div>
      </nav>
      <script type="text/javascript"
              tal:attributes="src here/portfolio/jsbuild/photo_view.js/absolute_url"></script>
    </div>
    <!-- /film_bar -->
  </body>
</html>
