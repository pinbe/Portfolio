{
    "compilerOptions": {
        "outDir": "./dist/",
        "sourceMap": true,
        "noImplicitAny": true,
        "module": "amd",
        "target": "es5",
        //        "jsx": "react",
        "lib": [
            "dom",
            "es2017"
        ],
        "allowJs": false,
        "pretty": true,
        "experimentalDecorators": true,
        "downlevelIteration": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "baseUrl": "./",
        "paths": {
            "*": [
                "./node_modules/@types/*",
                "../../../../photoprint/Products/photoprint/ts/node_modules/@types/*",
                "*"
            ]
        },
        "types": []
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "**/scratch.ts"
    ]
}
